<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: rgb(227, 223, 215);
            padding: 20px 30px;
        }

        nav {
            background: #2222;
            padding: 15px 25px;
            border-radius: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 8px rgba(123, 16, 16, 0.929);
            transition: 0.3s;

        }

        nav:hover {
            background-color: green;
            transform: scale(1.04);
        }

        nav .logo {
            font-size: 22px;
            font-weight: bold;
            color: black;
        }

        nav ul {
            display: flex;
            gap: 20px;
            list-style: none;
        }

        nav ul li a {
            text-decoration: none;
            color: black;
            font-weight: 700;
        }

        nav ul li a:hover {
            color: white;
            transform: scale(1.08);
        }

        /* HERO */
        .hero {
            margin-top: 30px;
            background: #2222;
            padding: 50px;
            border-radius: 12px;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
            transition: 0.3s;
        }

        .hero:hover {
            background-color: green;
            transform: scale(1.04);
        }

        .hero-text {
            width: 50%;
        }

        .hero-text h1 {
            font-size: 40px;
            margin-bottom: 20px;
            color: black;
        }

        .hero-text p {
            font-size: 18px;
            line-height: 1.4;
            margin-bottom: 20px;
        }

        .hero-text button {
            background: black;
            color: white;
            padding: 12px 25px;
            border-radius: 20px;
            font-size: 16px;
            border: none;
            cursor: pointer;
            transition: 0.4s;
        }

        .hero-text button:hover {
            background-color: #2222;
            transform: scale(1.08);
        }

        .hero-img {
            width: 50%;
        }

        .hero-img img {
            width: 100%;
            border-radius: 12px;
        }

        /* RESPONSIVE */
        @media (max-width: 700px) {
            .hero {
                flex-direction: column;
                text-align: center;
            }

            .hero-text,
            .hero-img {
                width: 100%;
            }
        }

        .grid-section {
            background: #2222;
            padding: 60px;
            border-radius: 10px;
            margin: 20px;
        }

        .grid-section h2 {
            color: white;
            text-align: center;
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(2, 3fr);
            gap: 10px;
            margin-top: 20px;
        }

        .grid-item {
            background: #2222;
            padding: 40px;
            border-radius: 10px;
            transition: 0.3s;
        }

        .grid-item:hover {
            background-color: green;
            transform: scale(1.04);
        }

        .form-section {
            background: linear-gradient(#0cecbb, #f20353f9, #b4e906);
            text-align: center;
            padding: 20px;
            margin: 30px;
            border-radius: 10px;
            box-shadow: 0 20px 30px rgba(24, 4, 4, 0.893);
        }

        .form-section h2,
        p {
            margin-bottom: 20px;
        }

        .form {
            display: flex;
            text-decoration: column;
            align-items: center;
        }

        input,
        textarea {
            width: 40%;
            padding: 10px;
            margin: 10px 0;
            border-radius: 10px;
            border: none;
            font-size: 10px;
        }

        input:focus,
        textarea:focus {
            outline: 2px solid #00c6ff;
        }

        button[type="submit"] {
            background: linear-gradient(to right, #00c6ff, #0072ff);
            color: white;
            padding: 10px 25px;
            border: none;
            border-radius: 20px;
            font-size: 16px;
            cursor: pointer;
            transition: 0.3s;
        }

        button[type="submit"]:hover {
            transform: scale(1.1);
            background: linear-gradient(to right, #0072ff, #00c6ff);
        }
    </style>
</head>

